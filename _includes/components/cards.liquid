<div class="grid gap-4 grid-cols-1 xl:grid-cols-2">
  {% for person in include.data %}
    {% assign image = person.id | author_image %}
    <article class="card-unipi sub-card-unipi flex items-center gap-3">
      {% if image %}<img
          src="{{ image | relative_url }}"
          alt="{{ person.name }}"
          class="card-picture pr-0">{% endif %}
      <div class="min-w-0 flex-1">
        <h3 class="text-sm">{% include partials/render-author.liquid id=person.id %}</h3>
        <p class="summary mt-1">{{ person.role }}</p>
        {% if person.homepage or person.github or person.scholar or person.orcid or person.links %}
          <div class="mt-3 flex flex-wrap gap-2">
            {% if person.homepage %}
              <a
                class="badge-ghost"
                href="{{ person.homepage }}"
                target="_blank"
                rel="noopener">
                <i class="{{ site.data.ui.people.links.homepage.icon }}"></i>
                {{ site.data.ui.people.links.homepage.label }}</a>
            {% endif %}
            {% if person.github %}
              <a
                class="badge-ghost"
                href="{{ person.github }}"
                target="_blank"
                rel="noopener">
                <i class="{{ site.data.ui.people.links.github.icon }}"></i>
                {{ site.data.ui.people.links.github.label }}</a>
            {% endif %}
            {% if person.scholar %}
              <a
                class="badge-ghost"
                href="{{ person.scholar }}"
                target="_blank"
                rel="noopener">
                <i class="{{ site.data.ui.people.links.scholar.icon }}"></i>
                {{ site.data.ui.people.links.scholar.label }}</a>
            {% endif %}
            {% if person.orcid %}
              <a
                class="badge-ghost"
                href="{{ person.orcid }}"
                target="_blank"
                rel="noopener">
                <i class="{{ site.data.ui.people.links.orcid.icon }}"></i>
                {{ site.data.ui.people.links.orcid.label }}</a>
            {% endif %}
            {% for link in person.links %}
              <a
                class="badge-ghost"
                href="{{ link.url }}"
                target="_blank"
                rel="noopener">
                {% if link.icon %}
                  <i class="{{ link.icon }}"></i>
                {% else %}
                  <i class="{{ site.data.ui.people.links.default.icon }}"></i>
                {% endif %}
                {{ link.label }}</a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </article>
  {% endfor %}
</div>